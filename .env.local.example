# API-Football (api-sports.io) server-side key. Omit to run in simulated-live mode.
API_FOOTBALL_KEY=
# World Cup competition identifiers on API-Football
WC_LEAGUE_ID=1
WC_SEASON=2026
# Max upstream requests per day (free tier hard cap is 100). Governor keeps us under this.
WC_DAILY_BUDGET=90
# Force simulated mode even if a key is present (useful for demos)
WC_FORCE_SIMULATED=false
